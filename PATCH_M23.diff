diff --git a/nrb-devops/audit/repro_engine.js b/nrb-devops/audit/repro_engine.js
new file mode 100644
--- /dev/null
+++ b/nrb-devops/audit/repro_engine.js
@@
+"use strict";
+const fs = require("fs");
+const crypto = require("crypto");
+
+function sha256File(path) {
+  const data = fs.readFileSync(path);
+  return crypto.createHash("sha256").update(data).digest("hex");
+}
+
+function collectSourceHashes(root = ".") {
+  const out = {};
+  function walk(dir) {
+    for (const f of fs.readdirSync(dir)) {
+      const p = dir + "/" + f;
+      if (p.includes(".git") || p.includes(".nrb")) continue;
+      const stat = fs.statSync(p);
+      if (stat.isDirectory()) walk(p);
+      else out[p] = sha256File(p);
+    }
+  }
+  walk(root);
+  return out;
+}
+
+function verifyReproducibility() {
+  if (!fs.existsSync(".nrb/freeze.json")) {
+    return { ok:false, reason:"No freeze snapshot" };
+  }
+  const freeze = JSON.parse(fs.readFileSync(".nrb/freeze.json"));
+  const current = collectSourceHashes(".");
+
+  for (const k of Object.keys(freeze.source_hashes || {})) {
+    if (current[k] !== freeze.source_hashes[k]) {
+      return { ok:false, reason:`Mismatch ${k}` };
+    }
+  }
+  return { ok:true };
+}
+
+module.exports = { verifyReproducibility };
+
diff --git a/nrb-devops/bin/nrb-repro b/nrb-devops/bin/nrb-repro
new file mode 100755
--- /dev/null
+++ b/nrb-devops/bin/nrb-repro
@@
+#!/usr/bin/env node
+const { verifyReproducibility } = require("../audit/repro_engine");
+
+const res = verifyReproducibility();
+if (!res.ok) {
+  console.error("[NRB][FAIL] Reproducibility:", res.reason);
+  process.exit(1);
+}
+console.log("[NRB][OK] Build reproducible");
+
